{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Sandboxed Electron shell for the staged DeepSeek Harness Web runtime",
  "productName": "DeepSeek Harness 客户端",
  "author": "DeepSeek Harness contributors",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -b && tsdown",
    "package": "tsx scripts/package.ts",
    "make": "pnpm run package && tsx scripts/make-installer.ts && node tests/write-installer-checksums.mjs out/make",
    "verify:package": "node tests/verify-package.mjs out",
    "verify:installer": "node tests/verify-installer.mjs out",
    "test": "vitest run --root ../.. apps/desktop/tests",
    "test:electron": "node tests/electron-shell.mjs",
    "test:packaged": "node tests/electron-shell.mjs --packaged"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-subprocess-local": "workspace:^"
  },
  "devDependencies": {
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "18.4.4",
    "@types/node": "^22.20.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.61.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
